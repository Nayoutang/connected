extends RefCounted
## Story content stays independent of simulation and presentation.
const LESSONS = [
	["归城 · 第一股水", "阿澄", "百阶城的台阶还在，水声却消失了。岑伯，我们先修哪里？", "岑伯", "先接通这段旧管。水会找到与源头相同的高度，哪怕先走一段下坡。", "阿澄", "那就从这株快干的小苗开始。让它喝到归城后的第一口水。"],
	["旧街 · 沉睡的闸门", "岑伯", "街坊离开时关上了闸门。手里的零件有限，要先看清哪条路通往用水处。", "阿澄", "我会把水送到需要它的地方。旧图纸上的路线，也许还可以改。"],
	["高台 · 留住雨水", "阿澄", "这座空水箱，可以成为下半段水路的起点。", "岑伯", "这是旧式教学装置。等去真正的街区维修，水箱里的水用完就会停，必须学会储存和分配。"],
	["钟楼 · 等待的机关", "岑伯", "弹簧阀会等待水的积累，再打开下一段通路。", "阿澄", "如果装置能彼此接力，我们就不用一直守在开关旁边了。修好这里，再去街区试试。"]
]
const LABS = [
	["屋顶温室 · 最后一箱雨", "岑伯", "屋顶只剩八升雨水，温室里的幼苗还在等。高台和低台都能装水箱，位置由你选。", "阿澄", "先把水留在合适的高度，再送到温室。每一升都要有去处。"],
	["两户灯火 · 共享一座水塔", "阿澄", "高处的住户和低处的公共厨房，都需要六升水。两边的连通管还会让水倒流。", "岑伯", "你可以手动分配，也可以让浮子指挥换向阀。只要两边都留住水，任何守规则的方案都算数。"],
	["无人苗圃 · 学会自己照料", "岑伯", "明天我们要去更远的街区。苗圃会一直用水，水箱却不能溢出。", "阿澄", "低水位补水，高水位停水。让浮子替我们看守，给这座城留下一个能自行运转的系统。"]
]
const ENDINGS = ["幼苗的叶子抬起来了。百阶城终于又有了一点水声。", "街角的水槽重新亮了起来。下一段管道，还在等我们。", "高台接住了来水。现在，去看看水怎样在更多装置之间接力。", "旧塔的机关醒了。接下来去涌现实验室，把学到的规则变成真正的街区水路。", "温室接到了雨水。我们留住的不只是水，还有下一季的种子。", "两户人家都留住了水。旧图纸没有画出我们的方案，但它确实运行了。", "我们松开了阀柄，水仍在按需要流动。百阶城的明天，从这一段自己运转的水路开始。"]

static func chapter(lab: bool, index: int, ending: bool = false) -> Array:
	var raw: Array = (LABS if lab else LESSONS)[index]
	if ending:
		return [{"place": raw[0], "speaker": "阿澄", "text": ENDINGS[index + (4 if lab else 0)]}]
	var lines: Array = []
	for i in range(1, raw.size(), 2):
		lines.append({"place": raw[0], "speaker": raw[i], "text": raw[i + 1]})
	return lines
