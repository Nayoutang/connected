static func chapter(lab: bool, index: int, ending: bool = false) -> Array:
	var chapters: Array = LABS if lab else LESSONS
	if index < 0 or index >= chapters.size():
		return []
	var raw: Array = chapters[index]
	if ending:
		return [{"place": raw[0], "speaker": "阿澄", "text": LEGACY_ENDINGS[index + 4] if lab else CHAPTER_ENDINGS[index]}]
	var lines: Array = []
	for i in range(1, raw.size(), 2):
		lines.append({"place": raw[0], "speaker": raw[i], "text": raw[i + 1]})
	return lines
